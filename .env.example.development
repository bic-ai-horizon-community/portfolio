# Development environment variables
# Copy this file to .env.local and replace every placeholder with your local/development value.

# PostgreSQL connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aihorizon?schema=public"
# Direct, non-pooled PostgreSQL connection used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aihorizon?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Add http://localhost:3000/api/auth/callback/google to the OAuth client's redirect URIs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Admin confirmation password for deleting events and workshops.
ADMIN_PASSWORD="replace-with-a-development-admin-password"
