# Production environment variables
# Copy this file to .env.local or configure these values in your hosting provider.

# PostgreSQL connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct, non-pooled PostgreSQL connection used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://your-domain.example"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Admin confirmation password for deleting events and workshops.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
